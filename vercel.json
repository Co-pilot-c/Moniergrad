{
  "buildCommand": "npx prisma generate && npx prisma db push --accept-data-loss",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/:path*", "destination": "/api/index.js" }
  ]
}
