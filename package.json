{
  "name": "tunakarya-cms-express",
  "version": "2.0.0",
  "description": "Custom Express CMS for Tunakarya with Prisma + Neon DB",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "vercel-build": "prisma generate && echo 'Build complete'"
  },
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "prisma": "^5.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
