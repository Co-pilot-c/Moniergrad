{
  "name": "tunakarya-cms-api",
  "version": "4.0.0",
  "description": "CMS API for Dewan Ambalan — Pure serverless, no Express",
  "scripts": {
    "dev": "node src/dev.js",
    "build": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:seed": "node src/seed.js",
    "vercel-build": "npx prisma generate && npx prisma db push --accept-data-loss"
  },
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "cloudinary": "^1.41.3",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "prisma": "^5.8.0"
  },
  "engines": {
    "node": "22.x"
  }
}
