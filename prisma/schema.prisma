// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MODEL: ADMIN USER (untuk CMS login)
// ============================================
model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String   @default("Administrator")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

// ============================================
// MODEL: HERO / HOME SECTION
// ============================================
model Hero {
  id            String   @id @default(cuid())
  title         String
  subtitle      String?
  description   String   @db.Text
  badgeText     String   @default("Welcome to Our Community") @map("badge_text")
  bgImage       String?  @map("bg_image")
  btn1Text      String   @default("Jelajahi") @map("btn1_text")
  btn1Link      String   @default("#about") @map("btn1_link")
  btn2Text      String   @default("Anggota") @map("btn2_text")
  btn2Link      String   @default("#strukture") @map("btn2_link")
  order         Int      @default(1)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("heroes")
}

// ============================================
// MODEL: ABOUT SECTION
// ============================================
model About {
  id              String   @id @default(cuid())
  tagline         String   @default("Tentang Kami")
  title           String
  description     String   @db.Text
  imageUrl        String?  @map("image_url")
  imageQuote      String?  @map("image_quote")
  visiTitle       String   @default("Visi") @map("visi_title")
  visiContent     String   @db.Text @map("visi_content")
  misiTitle       String   @default("Misi") @map("misi_title")
  misiItems       String   @db.Text @map("misi_items") // JSON array string
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("abouts")
}

// ============================================
// MODEL: STATS (120+, 92K, 25%, 12K+)
// ============================================
model Stats {
  id        String   @id @default(cuid())
  value     String   // bisa angka atau text: "120", "92K", "Aktif"
  suffix    String   @default("") // "+", "K", "%", "K+"
  label     String   // "Active", "Users", "Growth"
  isText    Boolean  @default(false) @map("is_text") // jika true, tampilkan value as-is tanpa animasi
  order     Int      @default(1)
  active    Boolean  @default(true)
  section   String   @default("about") // "about" atau "program"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("stats")
}

// ============================================
// MODEL: ANGKATAN (PERIODE ORGANISASI)
// ============================================
model Angkatan {
  id          String   @id @default(cuid())
  nama        String
  status      String   @default("Aktif")
  image       String?
  description String?  @db.Text
  order       Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members     AnggotaAngkatan[]

  @@map("angkatans")
}

// ============================================
// MODEL: ANGGOTA ANGKATAN
// ============================================
model AnggotaAngkatan {
  id          String   @id @default(cuid())
  angkatanId  String   @map("angkatan_id")
  name        String
  position    String
  image       String?
  bidang      String   @default("Umum")
  instagram   String?
  linkedin    String?
  order       Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  angkatan    Angkatan @relation(fields: [angkatanId], references: [id], onDelete: Cascade)

  @@map("anggota_angkatans")
}

// ============================================
// MODEL: STRUKTUR ORGANISASI
// ============================================
model Struktur {
  id              String   @id @default(cuid())
  title           String
  role            String
  image           String?
  angkatan        String   @default("51")
  angkatanImage   String?  @map("angkatan_image")
  angkatanStatus  String   @default("Aktif") @map("angkatan_status")
  order           Int      @default(1)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("strukturs")
}

// ============================================
// MODEL: PURNA KARYA / ALUMNI
// ============================================
model Purna {
  id          String   @id @default(cuid())
  title       String
  angkatan    String
  profile     String?
  quotes      String   @db.Text
  order       Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("purnas")
}

// ============================================
// MODEL: PROGRAM KERJA
// ============================================
model Program {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  description String   @db.Text
  images      String   @db.Text @default("[]") // JSON array of image URLs
  stats       String   @db.Text @default("[]") // JSON array: [{value,suffix,label,isText}]
  order       Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("programs")
}

// ============================================
// MODEL: FOOTER
// ============================================
model Footer {
  id              String   @id @default(cuid())
  brandName       String   @default("DewanAmbalan") @map("brand_name")
  brandDesc       String   @db.Text @map("brand_desc")
  facebookUrl     String?  @map("facebook_url")
  twitterUrl      String?  @map("twitter_url")
  instagramUrl    String?  @map("instagram_url")
  email           String?
  phone           String?
  address         String?
  copyrightText   String?  @map("copyright_text")
  navLinks        String   @db.Text @default("[]") @map("nav_links")   // JSON: [{label,url}]
  quickLinks      String   @db.Text @default("[]") @map("quick_links") // JSON: [{label,url}]
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("footers")
}

// ============================================
// MODEL: SITE SETTINGS
// ============================================
model SiteSettings {
  id              String   @id @default(cuid())
  siteTitle       String   @map("site_title")
  siteDescription String   @map("site_description")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// ============================================
// MODEL: CTA SECTION (Call to Action di Purna)
// ============================================
model Cta {
  id          String   @id @default(cuid())
  title       String   @default("Bergabunglah dengan Keluarga Besar Dewan Ambalan")
  description String   @db.Text @default("Jadilah bagian dari perjalanan inspiratif dan bentuk karakter kepemimpinanmu bersama kami.")
  btn1Text    String   @default("Bergabung Sekarang") @map("btn1_text")
  btn1Link    String   @default("#") @map("btn1_link")
  btn1Style   String   @default("primary") @map("btn1_style") // "primary" | "secondary"
  btn2Text    String   @default("Pelajari Lebih Lanjut") @map("btn2_text")
  btn2Link    String   @default("#") @map("btn2_link")
  btn2Style   String   @default("secondary") @map("btn2_style")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("ctas")
}

// ============================================
// MODEL: NAVIGATION MENU
// ============================================
model Navigation {
  id          String   @id @default(cuid())
  label       String
  url         String
  order       Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("navigations")
}
